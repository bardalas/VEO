<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="#000000">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent" android:layout_height="match_parent" />

    <!-- Live TV: channel name shown briefly after switching -->
    <!-- The translation, drawn by the app so that it can be moved in time without rebuilding
         anything (see Captions.kt). Tracks inside the video still come from the player's own view. -->
    <TextView
        android:id="@+id/cues"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginHorizontal="48dp" android:layout_marginBottom="48dp"
        android:gravity="center" android:textColor="#FFFFFF" android:textSize="22sp"
        android:shadowColor="#000000" android:shadowRadius="6" android:shadowDx="0" android:shadowDy="2"
        android:visibility="gone" />

    <!-- Paused: the picture is dimmed and two bars stand in the middle of it, so that a stopped film
         cannot be mistaken for one that is simply not moving. -->
    <LinearLayout
        android:id="@+id/pausebox"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:orientation="horizontal" android:gravity="center"
        android:background="#66000000" android:visibility="gone">
        <View android:layout_width="16dp" android:layout_height="72dp"
            android:background="#FFFFFF" android:layout_marginEnd="18dp" />
        <View android:layout_width="16dp" android:layout_height="72dp"
            android:background="#FFFFFF" />
    </LinearLayout>

    <!-- Paused: a quiet offer, never the point of the pause (PlayerActivity.showSyncHint) -->
    <TextView
        android:id="@+id/syncHint"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|center_horizontal" android:layout_marginTop="28dp"
        android:paddingHorizontal="18dp" android:paddingVertical="9dp"
        android:textSize="15sp" android:visibility="gone" />

    <TextView
        android:id="@+id/osd"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="top|end" android:layout_margin="20dp"
        android:background="#B3000000" android:paddingHorizontal="16dp" android:paddingVertical="8dp"
        android:textColor="#FFFFFF" android:textSize="20sp" android:visibility="gone" />

    <!-- Playback failed: what happened, and what the viewer can do about it -->
    <LinearLayout
        android:id="@+id/errbox"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:orientation="vertical"
        android:background="#E6000000" android:padding="28dp"
        android:visibility="gone">
        <TextView
            android:id="@+id/errTitle"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/errWhy"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="10dp" android:maxWidth="560dp"
            android:textColor="#AAB0BD" android:textSize="15sp" />
        <LinearLayout
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="20dp" android:orientation="horizontal">
            <Button
                android:id="@+id/errRetry" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="נסה שוב" android:textSize="17sp" />
            <Button
                android:id="@+id/errNext" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="הערוץ הבא" android:textSize="17sp" />
            <Button
                android:id="@+id/errBack" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="12dp" android:text="חזרה" android:textSize="17sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- Live TV: the info banner. Rises on every channel change and on Up/Down or OK: which channel, what is
         on now with how far along it is, and what follows. Up/Down page through the channels in it. -->
    <LinearLayout
        android:id="@+id/infobar"
        android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_gravity="bottom" android:orientation="vertical"
        android:background="#E6070910" android:paddingHorizontal="@dimen/info_pad_h" android:paddingVertical="@dimen/info_pad_v"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical">
            <TextView
                android:id="@+id/chNum"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:minWidth="@dimen/info_num_min" android:gravity="center"
                android:background="#F0B429" android:paddingHorizontal="8dp" android:paddingVertical="@dimen/info_num_pad_v"
                android:textColor="#14161F" android:textSize="@dimen/info_num_text" android:textStyle="bold" />
            <ImageView
                android:id="@+id/chLogo"
                android:layout_width="@dimen/info_logo_w" android:layout_height="@dimen/info_logo_h"
                android:layout_marginStart="@dimen/info_gap" android:scaleType="fitCenter"
                android:contentDescription="@null" android:visibility="gone" />
            <TextView
                android:id="@+id/chName"
                android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
                android:layout_marginStart="@dimen/info_gap" android:maxLines="1" android:ellipsize="end"
                android:textColor="#FFFFFF" android:textSize="@dimen/info_name_text" android:textStyle="bold" />
            <!-- live TV: what OK can do from here, small and in this row so the bar is no taller. OK acts on the lit one (Pause); Down steps into them (PlayerActivity.paintActions) -->
            <LinearLayout
                android:id="@+id/liveActions"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/info_gap" android:orientation="horizontal" android:gravity="center_vertical"
                android:visibility="gone">
                <TextView
                    android:id="@+id/actPause"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp" android:paddingVertical="2dp" android:textSize="@dimen/info_chip_text" android:textStyle="bold" />
                <TextView
                    android:id="@+id/actPrev"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp" android:paddingVertical="2dp" android:textSize="@dimen/info_chip_text" android:textStyle="bold" />
                <TextView
                    android:id="@+id/actNext"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp" android:paddingVertical="2dp" android:textSize="@dimen/info_chip_text" android:textStyle="bold" />
                <TextView
                    android:id="@+id/actChannels"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp" android:paddingVertical="2dp" android:textSize="@dimen/info_chip_text" android:textStyle="bold" />
                <TextView
                    android:id="@+id/actMore"
                    android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:paddingHorizontal="12dp" android:paddingVertical="2dp" android:textSize="@dimen/info_chip_text" android:textStyle="bold" />
            </LinearLayout>
            <TextView
                android:id="@+id/nowClock"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/info_gap"
                android:textColor="#AAB0BD" android:textSize="@dimen/info_clock_text" />
            <!-- live TV: live, or how far behind it, or a recording -->
            <TextView
                android:id="@+id/liveChip"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/info_gap" android:paddingHorizontal="12dp" android:paddingVertical="3dp"
                android:textSize="@dimen/info_chip_text" android:textStyle="bold" android:visibility="gone" />
        </LinearLayout>

        <TextView
            android:id="@+id/nowTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/info_title_top" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFF" android:textSize="@dimen/info_title_text" />

        <!-- how far in (and, on live, how far behind): fills from the side the layout starts from -->
        <com.veo.player.SeekBarView
            android:id="@+id/nowBar"
            android:layout_width="match_parent" android:layout_height="@dimen/info_bar_live"
            android:layout_marginTop="@dimen/info_bar_top" />

        <TextView
            android:id="@+id/nextTitle"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/info_next_top" android:maxLines="1" android:ellipsize="end"
            android:textColor="#AAB0BD" android:textSize="@dimen/info_next_text" />
    </LinearLayout>

    <!-- The sign of a seek: which way, and how far in all, while the key is pressed or held. -->
    <TextView
        android:id="@+id/seekSign"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center" android:paddingHorizontal="30dp" android:paddingVertical="14dp"
        android:textColor="#FFFFFF" android:textSize="34sp" android:textStyle="bold"
        android:visibility="gone" />

    <!-- A series: the episode after this one, offered as this one ends (OK plays it). -->
    <LinearLayout
        android:id="@+id/nextbox"
        android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="bottom|end" android:layout_margin="36dp"
        android:orientation="vertical" android:paddingHorizontal="22dp" android:paddingVertical="16dp"
        android:background="#F0070910" android:visibility="gone">
        <TextView
            android:id="@+id/nextLbl"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="הפרק הבא" android:textColor="#AAB0BD" android:textSize="14sp" />
        <TextView
            android:id="@+id/nextName"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:maxWidth="420dp" android:maxLines="1" android:ellipsize="end"
            android:textColor="#FFFFFF" android:textSize="18sp" android:textStyle="bold" />
        <TextView
            android:id="@+id/nextGo"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:paddingHorizontal="20dp" android:paddingVertical="9dp"
            android:textSize="17sp" android:textStyle="bold" />
    </LinearLayout>

    <!-- Live TV: the channel list, floating over the picture (long press OK). -->
    <FrameLayout
        android:id="@+id/chPanel"
        android:layout_width="match_parent" android:layout_height="match_parent"
        android:background="#99000000" android:visibility="gone">
        <ListView
            android:id="@+id/chList"
            android:layout_width="380dp" android:layout_height="match_parent"
            android:layout_gravity="start"
            android:background="#F2070910" android:divider="#1FFFFFFF" android:dividerHeight="1dp"
            android:listSelector="#33F0B429" android:scrollbars="none"
            android:paddingVertical="10dp" android:clipToPadding="false" />
    </FrameLayout>
</FrameLayout>
